{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/frontend/src",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-script",
      "options": {
        "script": "serve"
      }
    },
    "serve-e2e": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "bun run serve -- --port 4200"
          }
        ],
        "parallel": true,
        "cwd": "apps/frontend",
        "readyWhen": "Local:"
      },
      "continuous": true
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "frontend:build"
      }
    },
    "build": {
      "executor": "nx:run-script",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "script": "build"
      }
    },
    "start": {
      "executor": "nx:run-script",
      "options": {
        "script": "start"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint -c ../../.oxlintrc.json --disable-unicorn-plugin .",
        "cwd": "apps/frontend"
      }
    },
    "lint-fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint -c ../../.oxlintrc.json --disable-unicorn-plugin --fix .",
        "cwd": "apps/frontend"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxfmt -c ../../.oxfmtrc.json --ignore-path ../../.oxfmtignore --check .",
        "cwd": "apps/frontend"
      }
    },
    "format-fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxfmt -c ../../.oxfmtrc.json --ignore-path ../../.oxfmtignore --write .",
        "cwd": "apps/frontend"
      }
    }
  },
  "tags": [
    "type:app",
    "scope:frontend"
  ]
}
